# Model
BASE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma_tm_db

# API
CORS_ORIGINS=http://localhost:8501
MOCK_LLM=0

# --- Security -------------------------------------------------------------------------
# Leave both empty ONLY for local development: authentication is then DISABLED.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEYS       : may call /translate            (comma separated, >= 12 characters each)
# ADMIN_API_KEYS : may also write the translation memory (/memory/index) and clear the cache
API_KEYS=
ADMIN_API_KEYS=

# Rate limits per client IP ("N/second|minute|hour|day"); defaults shown
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_TRANSLATE=30/minute
# RATE_LIMIT_MEMORY_INDEX=10/minute
# RATE_LIMIT_ADMIN=5/minute

# How many generations may run at the same time (protects the GPU)
# MAX_CONCURRENT_GENERATIONS=1

# UI (the keys the Streamlit app sends to the API)
API_BASE_URL=http://localhost:8000/api/v1
API_KEY=
ADMIN_API_KEY=

# Logging
LOG_LEVEL=INFO
